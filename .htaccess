# Ramayan CMS — Apache Rewrite Rules
# finggu.com | Author: sudarshanpjadhav
# Part of the Ramayan CMS Ecosystem

# ─── PHP Settings ─────────────────────────────────────────────────────────────
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size       64M
    php_value memory_limit        256M
    php_value max_execution_time  300
</IfModule>

# ─── Security Headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options            "SAMEORIGIN"
    Header always set X-Content-Type-Options     "nosniff"
    Header always set X-XSS-Protection           "1; mode=block"
    Header always set Referrer-Policy            "strict-origin-when-cross-origin"
    Header always set Permissions-Policy         "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ─── Protect Sensitive Files ──────────────────────────────────────────────────
<FilesMatch "^(ramayan-config\.php|ramayan-config-sample\.php|\.env|composer\.json|composer\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ─── Block Access to Core Directories ────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to ram/ core directory
    RewriteRule ^ram/(.*)$ index.php [L,F]

    # Block direct access to logs/
    RewriteRule ^logs/(.*)$ - [F,L]

    # Block direct access to cache/ (only .html cached pages are allowed via file serving)
    RewriteRule ^cache/(.*)\.php$ - [F,L]
</IfModule>

# ─── URL Rewriting ─────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /rmcms/

    # Do not rewrite if it's a real file or directory
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Swayamvar installer — pass through directly
    RewriteRule ^swayamvar/ - [L]

    # API routes → index.php
    RewriteRule ^api/(.*)$ index.php [QSA,L]

    # Admin panel routes → ayodhya/index.php
    RewriteRule ^ayodhya/(.*)$ ayodhya/index.php [QSA,L]

    # All other requests → index.php (Pushpak router handles)
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ─── Disable Directory Listing ────────────────────────────────────────────────
Options -Indexes

# ─── Block Bad Bots & Exploits ────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (masscan|nikto|sqlmap|nmap|acunetix|w3af|dirbuster) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ─── Gzip Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml application/xml text/plain
</IfModule>

# ─── Browser Caching ──────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/gif              "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript       "access plus 1 month"
    ExpiresByType application/json      "access plus 0 seconds"
</IfModule>
